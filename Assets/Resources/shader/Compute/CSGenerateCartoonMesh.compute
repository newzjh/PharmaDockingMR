#pragma kernel CSBuildCartoonGraphBatch
#pragma kernel CSBuildCartoonLayoutBatch
#pragma kernel CSGenerateCartoonMesh
#pragma enable_d3d11_debug_symbols

#include "AtomCommon.hlsl"

// Cartoon mode uses a uniform tube-like radius for both atoms and bonds.
int atomSegments = 6;
int bondSegments = 6;
float atomRadius = 0.3f;
float bondRadius = 0.3f;

// Batch mode parses SMILES on the GPU in two preprocessing stages.
int batchSize;
int selectedCount;
int useSmilesTextureInput;
int smilesMaxLength;
int sphereSegments;
int cylinderSegments;
float bondLength;
int topK;
int maxBondCount;
int vertexCapacity;

StructuredBuffer<int> smilesInputBuffer;
Texture2D<float4> smilesInputTexture;
StructuredBuffer<int> selectedMolIndexBuffer;
StructuredBuffer<int> meshAtomStartBuffer;
RWStructuredBuffer<int> meshAtomCountInputBuffer;
StructuredBuffer<int> meshBondStartBuffer;
RWStructuredBuffer<int> meshBondCountInputBuffer;
RWStructuredBuffer<int> atomTypeInputBuffer;
RWStructuredBuffer<float3> atomPositionInputBuffer;
RWStructuredBuffer<int2> bondInputBuffer;
RWStructuredBuffer<float3> vertexPosNormalBuffer;
RWStructuredBuffer<float4> vertexOutputBuffer_color;
RWStructuredBuffer<int> indexOutputBuffer;

bool TryMapSimpleAtom(int c0, int c1, out int atomType, out int consumed)
{
    atomType = ATOM_TYPE_UNKNOWN;
    consumed = 0;

    if (c0 == 0)
        return false;

    if (c0 == 'C' && c1 == 'l') { atomType = ATOM_TYPE_Cl; consumed = 2; return true; }
    if (c0 == 'B' && c1 == 'r') { atomType = ATOM_TYPE_Br; consumed = 2; return true; }
    if (c0 == 'S' && c1 == 'i') { atomType = ATOM_TYPE_Si; consumed = 2; return true; }
    if (c0 == 'A' && c1 == 's') { atomType = ATOM_TYPE_As; consumed = 2; return true; }
    if (c0 == 'S' && c1 == 'e') { atomType = ATOM_TYPE_Se; consumed = 2; return true; }

    consumed = 1;
    switch (c0)
    {
        case 'H': atomType = ATOM_TYPE_H; return true;
        case 'B': atomType = ATOM_TYPE_B; return true;
        case 'C': atomType = ATOM_TYPE_C; return true;
        case 'N': atomType = ATOM_TYPE_N; return true;
        case 'O': atomType = ATOM_TYPE_O; return true;
        case 'F': atomType = ATOM_TYPE_F; return true;
        case 'P': atomType = ATOM_TYPE_P; return true;
        case 'S': atomType = ATOM_TYPE_S; return true;
        case 'I': atomType = ATOM_TYPE_I; return true;
        case 'c': atomType = ATOM_TYPE_c; return true;
        case 'n': atomType = ATOM_TYPE_n; return true;
        case 'o': atomType = ATOM_TYPE_o; return true;
        case 's': atomType = ATOM_TYPE_s; return true;
        case 'p': atomType = ATOM_TYPE_p; return true;
        default:
            return false;
    }
}

float Hash01(uint seed)
{
    return frac(sin(seed * 12.9898f + 78.233f) * 43758.5453f);
}

[numthreads(32, 1, 1)]
void CSBuildCartoonGraphBatch(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int meshIdx = dispatchThreadID.x;
    if (meshIdx >= selectedCount)
        return;

    int atomStart = meshAtomStartBuffer[meshIdx];
    int bondStart = meshBondStartBuffer[meshIdx];

    int ringAtom[10];
    int ringBond[10];
    int branchStack[16];
    for (int r = 0; r < 10; r++) { ringAtom[r] = -1; ringBond[r] = 0; }
    int branchTop = 0;
    int atomCount = 0;
    int writeBondCount = 0;
    int currentAtom = -1;
    int pendingBond = 0;
    int molIdx = selectedMolIndexBuffer[meshIdx];
    if (molIdx < 0 || molIdx >= batchSize)
    {
        meshAtomCountInputBuffer[meshIdx] = 0;
        meshBondCountInputBuffer[meshIdx] = 0;
        return;
    }
    int i = 0;
    while (i < smilesMaxLength && atomCount < MAX_ATOM_COUNT)
    {
        int c0 = useSmilesTextureInput != 0
            ? (int)round(smilesInputTexture[int2(i, molIdx)].r * 255.0f)
            : smilesInputBuffer[molIdx * smilesMaxLength + i];
        int c1 = 0;
        if (i + 1 < smilesMaxLength)
        {
            c1 = useSmilesTextureInput != 0
                ? (int)round(smilesInputTexture[int2(i + 1, molIdx)].r * 255.0f)
                : smilesInputBuffer[molIdx * smilesMaxLength + i + 1];
        }
        if (c0 == 0)
            break;

        if (c0 == '=') { pendingBond = 1; i++; continue; }
        if (c0 == '#') { pendingBond = 2; i++; continue; }
        if (c0 == ':') { pendingBond = 3; i++; continue; }
        if (c0 == '-') { pendingBond = 0; i++; continue; }
        if (c0 == '(') { if (branchTop < 16) branchStack[branchTop++] = currentAtom; i++; continue; }
        if (c0 == ')') { if (branchTop > 0) currentAtom = branchStack[--branchTop]; i++; continue; }
        if (c0 == '[')
        {
            int end = i + 1;
            while (end < smilesMaxLength)
            {
                int ce = useSmilesTextureInput != 0
                    ? (int)round(smilesInputTexture[int2(end, molIdx)].r * 255.0f)
                    : smilesInputBuffer[molIdx * smilesMaxLength + end];
                if (ce == 0 || ce == ']')
                    break;
                end++;
            }

            int mappedType = ATOM_TYPE_UNKNOWN;
            bool mapped = false;
            for (int p = i + 1; p < end && !mapped; p++)
            {
                int ca = useSmilesTextureInput != 0
                    ? (int)round(smilesInputTexture[int2(p, molIdx)].r * 255.0f)
                    : smilesInputBuffer[molIdx * smilesMaxLength + p];
                int cb = 0;
                if (p + 1 < end)
                {
                    cb = useSmilesTextureInput != 0
                        ? (int)round(smilesInputTexture[int2(p + 1, molIdx)].r * 255.0f)
                        : smilesInputBuffer[molIdx * smilesMaxLength + p + 1];
                }
                int consumedTmp;
                if (TryMapSimpleAtom(ca, cb, mappedType, consumedTmp))
                    mapped = true;
            }

            if (mapped)
            {
                int newAtom = atomCount;
                atomTypeInputBuffer[atomStart + newAtom] = mappedType;
                atomPositionInputBuffer[atomStart + newAtom] = float3(0, 0, 0);
                if (currentAtom >= 0 && writeBondCount < maxBondCount)
                    bondInputBuffer[bondStart + writeBondCount++] = int2(currentAtom, newAtom);
                currentAtom = newAtom;
                atomCount++;
            }
            pendingBond = 0;
            i = min(end + 1, smilesMaxLength);
            continue;
        }
        if (c0 >= '0' && c0 <= '9')
        {
            int ring = c0 - '0';
            if (ring >= 0 && ring < 10 && currentAtom >= 0)
            {
                if (ringAtom[ring] >= 0)
                {
                    if (writeBondCount < maxBondCount)
                        bondInputBuffer[bondStart + writeBondCount++] = int2(ringAtom[ring], currentAtom);
                    ringAtom[ring] = -1;
                    ringBond[ring] = 0;
                }
                else
                {
                    ringAtom[ring] = currentAtom;
                    ringBond[ring] = pendingBond;
                }
            }
            pendingBond = 0;
            i++;
            continue;
        }

        int atomType;
        int consumed;
        if (TryMapSimpleAtom(c0, c1, atomType, consumed))
        {
            int newAtom = atomCount;
            atomTypeInputBuffer[atomStart + newAtom] = atomType;
            atomPositionInputBuffer[atomStart + newAtom] = float3(0, 0, 0);
            if (currentAtom >= 0 && writeBondCount < maxBondCount)
                bondInputBuffer[bondStart + writeBondCount++] = int2(currentAtom, newAtom);
            currentAtom = newAtom;
            atomCount++;
            pendingBond = 0;
            i += consumed;
            continue;
        }

        i++;
    }

    for (int atomIdx = atomCount; atomIdx < MAX_ATOM_COUNT; atomIdx++)
    {
        atomTypeInputBuffer[atomStart + atomIdx] = 0;
        atomPositionInputBuffer[atomStart + atomIdx] = float3(0, 0, 0);
    }

    for (int bondIdx = writeBondCount; bondIdx < maxBondCount; bondIdx++)
        bondInputBuffer[bondStart + bondIdx] = int2(0, 0);

    meshAtomCountInputBuffer[meshIdx] = atomCount;
    meshBondCountInputBuffer[meshIdx] = writeBondCount;
}

[numthreads(32, 1, 1)]
void CSBuildCartoonLayoutBatch(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int meshIdx = dispatchThreadID.x;
    if (meshIdx >= selectedCount)
        return;

    int atomStart = meshAtomStartBuffer[meshIdx];
    int atomCount = meshAtomCountInputBuffer[meshIdx];
    if (atomCount <= 0)
        return;

    int bondStart = meshBondStartBuffer[meshIdx];
    int bondCount = meshBondCountInputBuffer[meshIdx];
    int degree[MAX_ATOM_COUNT];
    int neighbors[MAX_ATOM_COUNT * MAX_GRAPH_NEIGHBORS];
    bool bondedFlags[MAX_ATOM_COUNT * MAX_ATOM_COUNT];
    for (int a = 0; a < atomCount; a++)
    {
        degree[a] = 0;
        for (int s = 0; s < MAX_GRAPH_NEIGHBORS; s++)
            neighbors[a * MAX_GRAPH_NEIGHBORS + s] = -1;
        for (int b = 0; b < atomCount; b++)
            bondedFlags[a * atomCount + b] = false;
    }
    for (int b = 0; b < bondCount; b++)
    {
        int2 bond = bondInputBuffer[bondStart + b];
        int a0 = clamp(bond.x, 0, atomCount - 1);
        int a1 = clamp(bond.y, 0, atomCount - 1);
        if (a0 == a1) continue;
        bondedFlags[a0 * atomCount + a1] = true;
        bondedFlags[a1 * atomCount + a0] = true;
        if (degree[a0] < MAX_GRAPH_NEIGHBORS)
            neighbors[a0 * MAX_GRAPH_NEIGHBORS + degree[a0]++] = a1;
        if (degree[a1] < MAX_GRAPH_NEIGHBORS)
            neighbors[a1 * MAX_GRAPH_NEIGHBORS + degree[a1]++] = a0;
    }

    float3 positions[MAX_ATOM_COUNT];
    int parent[MAX_ATOM_COUNT];
    int depth[MAX_ATOM_COUNT];
    bool placed[MAX_ATOM_COUNT];
    int queue[MAX_ATOM_COUNT];
    for (int i = 0; i < atomCount; i++)
    {
        positions[i] = float3(0, 0, 0);
        parent[i] = -1;
        depth[i] = 0;
        placed[i] = false;
    }

    int qHead = 0, qTail = 0;
    placed[0] = true;
    queue[qTail++] = 0;
    while (qHead < qTail)
    {
        int current = queue[qHead++];
        int children[MAX_GRAPH_NEIGHBORS];
        int childCount = 0;
        for (int s = 0; s < degree[current]; s++)
        {
            int n = neighbors[current * MAX_GRAPH_NEIGHBORS + s];
            if (n < 0 || placed[n]) continue;
            children[childCount++] = n;
        }

        float3 parentDir = float3(1, 0, 0);
        if (parent[current] >= 0)
        {
            parentDir = positions[current] - positions[parent[current]];
            float d = length(parentDir);
            parentDir = d < 1e-6f ? float3(1, 0, 0) : parentDir / d;
        }
        float baseAngle = atan2(parentDir.y, parentDir.x);
        float spread = childCount > 1 ? 1.8f : 0.0f;
        for (int c = 0; c < childCount; c++)
        {
            int child = children[c];
            float t = childCount == 1 ? 0.5f : (float)c / (childCount - 1);
            float angle = baseAngle + lerp(-spread, spread, t);
            float3 offset = normalize(float3(cos(angle), sin(angle), (depth[current] & 1) == 0 ? 0.15f : -0.15f)) * bondLength;
            positions[child] = positions[current] + offset;
            parent[child] = current;
            depth[child] = depth[current] + 1;
            placed[child] = true;
            queue[qTail++] = child;
        }
    }

    for (int iter = 0; iter < 4; iter++)
    {
        for (int bondIdx = 0; bondIdx < bondCount; bondIdx++)
        {
            int2 bond = bondInputBuffer[bondStart + bondIdx];
            int atomA = clamp(bond.x, 0, atomCount - 1);
            int atomB = clamp(bond.y, 0, atomCount - 1);
            if (atomA == atomB)
                continue;

            float3 pa = positions[atomA];
            float3 pb = positions[atomB];
            float3 delta = pb - pa;
            float dist = max(length(delta), 1e-4f);
            float3 correction = delta * ((dist - bondLength) / dist) * 0.18f;
            if (atomA != 0)
                pa += correction * 0.5f;
            pb -= correction * 0.5f;
            positions[atomA] = pa;
            positions[atomB] = pb;
        }

        for (int a = 0; a < atomCount; a++)
        {
            for (int b = a + 1; b < atomCount; b++)
            {
                if (bondedFlags[a * atomCount + b])
                    continue;

                float3 pa = positions[a];
                float3 pb = positions[b];
                float3 delta = pb - pa;
                float dist = max(length(delta), 1e-4f);
                float minDist = bondLength * 0.75f;
                if (dist < minDist)
                {
                    float3 repel = delta * ((minDist - dist) / dist) * 0.06f;
                    if (a != 0) pa -= repel;
                    pb += repel;
                    positions[a] = pa;
                    positions[b] = pb;
                }
            }
        }
    }

    for (int i = 0; i < atomCount; i++)
        atomPositionInputBuffer[atomStart + i] = positions[i];
}
// Emit a compact sphere so cartoon mode keeps a smoother silhouette.
void GenerateAtomSphere(float3 center, int type, int vertexOffset, int indexOffset, inout int vCount, inout int iCount)
{
    float radius = atomRadius;
    float4 color = GetAtomColor(type);
    float thetaStep = 2 * 3.1415926f / sphereSegments;
    float phiStep = 3.1415926f / sphereSegments;

    int beginVCount = vCount;
    
    for (int y = 0; y <= sphereSegments; y++)
    {
        float phi = y * phiStep;
        float sinPhi = sin(phi);
        float cosPhi = cos(phi);

        for (int x = 0; x <= sphereSegments; x++)
        {
            float theta = x * thetaStep;
            float sinTheta = sin(theta);
            float cosTheta = cos(theta);

            float3 pos = float3(
                radius * sinPhi * cosTheta,
                radius * sinPhi * sinTheta,
                radius * cosPhi
            ) + center;
            float3 normal = normalize(pos - center);

            int outIdx = vertexOffset + vCount;
            vertexPosNormalBuffer[outIdx] = pos;
            vertexPosNormalBuffer[vertexCapacity + outIdx] = normal;
            vertexOutputBuffer_color[vertexOffset + vCount] = color;
            vCount++;
        }
    }

    for (int y = 0; y < sphereSegments; y++)
    {
        for (int x = 0; x < sphereSegments; x++)
        {
            int v0 = x + y * (sphereSegments + 1);
            int v1 = v0 + 1;
            int v2 = v0 + (sphereSegments + 1);
            int v3 = v2 + 1;

            indexOutputBuffer[indexOffset + iCount++] = v0 + beginVCount;
            indexOutputBuffer[indexOffset + iCount++] = v2 + beginVCount;
            indexOutputBuffer[indexOffset + iCount++] = v1 + beginVCount;

            indexOutputBuffer[indexOffset + iCount++] = v1 + beginVCount;
            indexOutputBuffer[indexOffset + iCount++] = v2 + beginVCount;
            indexOutputBuffer[indexOffset + iCount++] = v3 + beginVCount;
        }
    }
}

// Emit a smooth cylinder between bonded atoms.
void GenerateBondCylinder(float3 start, float3 end, float4 color, int vertexOffset, int indexOffset, inout int vCount, inout int iCount)
{
    float3 dir = normalize(end - start);
    float3 up = abs(dir.y) < 0.9f ? float3(0, 1, 0) : float3(1, 0, 0);
    float3 right = normalize(cross(dir, up));
    up = normalize(cross(right, dir));
    float length = distance(start, end);
    
    int beginVCount = vCount;

    for (int i = 0; i <= cylinderSegments; i++)
    {
        float angle = i * 2 * 3.1415926f / cylinderSegments;
        float x = cos(angle);
        float z = sin(angle);

        float3 offset = right * x * bondRadius + up * z * bondRadius;
        int outIdx0 = vertexOffset + vCount;
        vertexPosNormalBuffer[outIdx0] = start + offset;
        vertexPosNormalBuffer[vertexCapacity + outIdx0] = normalize(offset);
        vertexOutputBuffer_color[vertexOffset + vCount] = color;
        vCount++;

        int outIdx1 = vertexOffset + vCount;
        vertexPosNormalBuffer[outIdx1] = end + offset;
        vertexPosNormalBuffer[vertexCapacity + outIdx1] = normalize(offset);
        vertexOutputBuffer_color[vertexOffset + vCount] = color;
        vCount++;
    }

    for (int i = 0; i < cylinderSegments; i++)
    {
        int v0 = i * 2;
        int v1 = v0 + 1;
        int v2 = (i + 1) * 2;
        int v3 = v2 + 1;

        indexOutputBuffer[indexOffset + iCount++] = v0 + beginVCount;
        indexOutputBuffer[indexOffset + iCount++] = v1 + beginVCount;
        indexOutputBuffer[indexOffset + iCount++] = v2 + beginVCount;

        indexOutputBuffer[indexOffset + iCount++] = v1 + beginVCount;
        indexOutputBuffer[indexOffset + iCount++] = v3 + beginVCount;
        indexOutputBuffer[indexOffset + iCount++] = v2 + beginVCount;
    }
}

[numthreads(32, 1, 1)]
void CSGenerateCartoonMesh(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int meshIdx = dispatchThreadID.x;
    if (meshIdx >= selectedCount)
        return;

    int atomStart = meshAtomStartBuffer[meshIdx];
    int atomCount = meshAtomCountInputBuffer[meshIdx];
    int bondStart = meshBondStartBuffer[meshIdx];
    int bondCount = meshBondCountInputBuffer[meshIdx];
    if (atomCount <= 1)
    {
        meshAtomCountInputBuffer[meshIdx] = 0;
        meshBondCountInputBuffer[meshIdx] = 0;
        return;
    }

    int verticesPerAtom = (sphereSegments + 1) * (sphereSegments + 1);
    int verticesPerBond = 2 * (cylinderSegments + 1);
    int indicesPerAtom = sphereSegments * sphereSegments * 6;
    int indicesPerBond = cylinderSegments * 6;

    int totalVertices = MAX_ATOM_COUNT * verticesPerAtom + maxBondCount * verticesPerBond;
    int totalIndices = MAX_ATOM_COUNT * indicesPerAtom + maxBondCount * indicesPerBond;
    int vertexOffset = meshIdx * totalVertices;
    int indexOffset = meshIdx * totalIndices;

    int vCount = 0;
    int iCount = 0;
    int emittedBondCount = 0;

    for (int a = 0; a < atomCount; a++)
    {
        int atomIndex = atomStart + a;
        GenerateAtomSphere(atomPositionInputBuffer[atomIndex], atomTypeInputBuffer[atomIndex], vertexOffset, indexOffset, vCount, iCount);
    }

    for (int bondIdx = 0; bondIdx < bondCount; bondIdx++)
    {
        int2 bond = bondInputBuffer[bondStart + bondIdx];
        if (bond.x < 0 || bond.y < 0 || bond.x >= atomCount || bond.y >= atomCount || bond.x == bond.y)
            continue;
        int atomA = atomStart + bond.x;
        int atomB = atomStart + bond.y;
        if (distance(atomPositionInputBuffer[atomA], atomPositionInputBuffer[atomB]) < 1e-4f)
            continue;
        float4 color = (GetAtomColor(atomTypeInputBuffer[atomA]) + GetAtomColor(atomTypeInputBuffer[atomB])) * 0.5f;
        GenerateBondCylinder(atomPositionInputBuffer[atomA], atomPositionInputBuffer[atomB], color, vertexOffset, indexOffset, vCount, iCount);
        emittedBondCount++;
    }
    meshBondCountInputBuffer[meshIdx] = emittedBondCount;
}
