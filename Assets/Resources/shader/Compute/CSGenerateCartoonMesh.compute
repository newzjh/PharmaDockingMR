#pragma kernel CSGenerateCartoonMesh
#pragma enable_d3d11_debug_symbols

#include "AtomCommon.hlsl"

// --- 参数配置 ---
int atomSegments = 6;    // 低面数原�?
int bondSegments = 6;    // 六边形键
float atomRadius = 0.3f; // 与键半径一致，形成Licorice/Cartoon连续�?
float bondRadius = 0.3f;

// C#浼犻€掔殑鍏ㄥ眬鍙傛�?
int batchSize;
int selectedCount;
int useSmilesTextureInput;
int sphereSegments;
int cylinderSegments;
float bondLength;
int topK;
int maxBondCount;

// 杈撳叆杈撳嚭Buffer
StructuredBuffer<int> smilesInputBuffer;
Texture2D<float4> smilesInputTexture;
StructuredBuffer<int> selectedMolIndexBuffer;
RWStructuredBuffer<float3> vertexOutputBuffer_position;
RWStructuredBuffer<float3> vertexOutputBuffer_normal;
RWStructuredBuffer<float4> vertexOutputBuffer_color;
RWStructuredBuffer<int> indexOutputBuffer;
RWStructuredBuffer<int> atomCountOutputBuffer;
RWStructuredBuffer<int> bondCountOutputBuffer;





// 鐢熸垚鍘熷瓙鐞冮《鐐?娉曠�?棰滆�?
void GenerateAtomSphere(float3 center, int type, int vertexOffset, int indexOffset, inout int vCount, inout int iCount)
{
    float radius = atomRadius; // Cartoon: 强制使用相同的半径
    float4 color = GetAtomColor(type);
    float thetaStep = 2 * 3.1415926f / sphereSegments;
    float phiStep = 3.1415926f / sphereSegments;

    int beginVCount = vCount;
    
    for (int y = 0; y <= sphereSegments; y++)
    {
        float phi = y * phiStep;
        float sinPhi = sin(phi);
        float cosPhi = cos(phi);

        for (int x = 0; x <= sphereSegments; x++)
        {
            float theta = x * thetaStep;
            float sinTheta = sin(theta);
            float cosTheta = cos(theta);

            // 鐞冮《鐐瑰潗�?
            float3 pos = float3(
                radius * sinPhi * cosTheta,
                radius * sinPhi * sinTheta,
                radius * cosPhi
            ) + center;
            float3 normal = normalize(pos - center);

            // 鍐欏叆椤剁偣Buffer
            vertexOutputBuffer_position[vertexOffset + vCount] = pos;
            vertexOutputBuffer_normal[vertexOffset + vCount] = normal;
            vertexOutputBuffer_color[vertexOffset + vCount] = color;
            vCount++;
        }
    }

    // 鐢熸垚鐞冧笁瑙掔储寮?
    for (int y = 0; y < sphereSegments; y++)
    {
        for (int x = 0; x < sphereSegments; x++)
        {
            int v0 = x + y * (sphereSegments + 1);
            int v1 = v0 + 1;
            int v2 = v0 + (sphereSegments + 1);
            int v3 = v2 + 1;

            //indexOutputBuffer[indexOffset + iCount++] = v0 + vertexOffset;
            //indexOutputBuffer[indexOffset + iCount++] = v2 + vertexOffset;
            //indexOutputBuffer[indexOffset + iCount++] = v1 + vertexOffset;

            //indexOutputBuffer[indexOffset + iCount++] = v1 + vertexOffset;
            //indexOutputBuffer[indexOffset + iCount++] = v2 + vertexOffset;
            //indexOutputBuffer[indexOffset + iCount++] = v3 + vertexOffset;
            
            indexOutputBuffer[indexOffset + iCount++] = v0 + beginVCount;
            indexOutputBuffer[indexOffset + iCount++] = v2 + beginVCount;
            indexOutputBuffer[indexOffset + iCount++] = v1 + beginVCount;

            indexOutputBuffer[indexOffset + iCount++] = v1 + beginVCount;
            indexOutputBuffer[indexOffset + iCount++] = v2 + beginVCount;
            indexOutputBuffer[indexOffset + iCount++] = v3 + beginVCount;
        }
    }
}

// 鐢熸垚鍖栧閿渾鏌憋紙妫嶏�?
void GenerateBondCylinder(float3 start, float3 end, float4 color, int vertexOffset, int indexOffset, inout int vCount, inout int iCount)
{
    float3 dir = normalize(end - start);
    float3 up = abs(dir.y) < 0.9f ? float3(0, 1, 0) : float3(1, 0, 0);
    float3 right = normalize(cross(dir, up));
    up = normalize(cross(right, dir));
    float length = distance(start, end);
    
    int beginVCount = vCount;

    // 鐢熸垚鍦嗘煴涓ょ椤剁偣
    for (int i = 0; i <= cylinderSegments; i++)
    {
        float angle = i * 2 * 3.1415926f / cylinderSegments;
        float x = cos(angle);
        float z = sin(angle);

        float3 offset = right * x * bondRadius + up * z * bondRadius;
        vertexOutputBuffer_position[vertexOffset + vCount] = start + offset;
        vertexOutputBuffer_normal[vertexOffset + vCount] = normalize(offset);
        vertexOutputBuffer_color[vertexOffset + vCount] = color;
        vCount++;

        vertexOutputBuffer_position[vertexOffset + vCount] = end + offset;
        vertexOutputBuffer_normal[vertexOffset + vCount] = normalize(offset);
        vertexOutputBuffer_color[vertexOffset + vCount] = color;
        vCount++;
    }

    // 鐢熸垚鍦嗘煴涓夎绱㈠紩
    for (int i = 0; i < cylinderSegments; i++)
    {
        int v0 = i * 2;
        int v1 = v0 + 1;
        int v2 = (i + 1) * 2;
        int v3 = v2 + 1;

        indexOutputBuffer[indexOffset + iCount++] = v0 + beginVCount;
        indexOutputBuffer[indexOffset + iCount++] = v1 + beginVCount;
        indexOutputBuffer[indexOffset + iCount++] = v2 + beginVCount;

        indexOutputBuffer[indexOffset + iCount++] = v1 + beginVCount;
        indexOutputBuffer[indexOffset + iCount++] = v3 + beginVCount;
        indexOutputBuffer[indexOffset + iCount++] = v2 + beginVCount;
    }
}

void BuildAtomLayout(in int bondMatrix[MAX_ATOM_COUNT * MAX_ATOM_COUNT], int atomCount, out float3 atomPositions[MAX_ATOM_COUNT])
{
    int parent[MAX_ATOM_COUNT];
    int depth[MAX_ATOM_COUNT];
    int placed[MAX_ATOM_COUNT];
    int queue[MAX_ATOM_COUNT];
    int queueHead = 0;
    int queueTail = 0;

    for (int i = 0; i < MAX_ATOM_COUNT; i++)
    {
        atomPositions[i] = float3(0, 0, 0);
        parent[i] = -1;
        depth[i] = 0;
        placed[i] = 0;
    }

    atomPositions[0] = float3(0, 0, 0);
    placed[0] = 1;
    queue[queueTail++] = 0;

    while (queueHead < queueTail)
    {
        int current = queue[queueHead++];
        int children[MAX_ATOM_COUNT];
        int childCount = 0;

        for (int neighbor = 0; neighbor < atomCount; neighbor++)
        {
            if (neighbor == current || GetBondValue(bondMatrix, current, neighbor) == BOND_UNKNOWN || placed[neighbor] != 0)
                continue;

            children[childCount++] = neighbor;
        }

        float3 parentDir = float3(1, 0, 0);
        if (parent[current] >= 0)
        {
            parentDir = atomPositions[current] - atomPositions[parent[current]];
            if (length(parentDir) < 1e-4f)
                parentDir = float3(1, 0, 0);
            else
                parentDir = normalize(parentDir);
        }

        float baseAngle = atan2(parentDir.y, parentDir.x);
        float spread = childCount > 1 ? 1.8f : 0.0f;

        for (int c = 0; c < childCount; c++)
        {
            int child = children[c];
            float angleOffset = childCount == 1 ? 0.0f : lerp(-spread, spread, (float) c / (float) (childCount - 1));
            float angle = baseAngle + angleOffset;
            float3 offset = float3(cos(angle), sin(angle), 0.15f * (depth[current] % 2 == 0 ? 1 : -1));
            offset = normalize(offset) * bondLength;

            atomPositions[child] = atomPositions[current] + offset;
            parent[child] = current;
            depth[child] = depth[current] + 1;
            placed[child] = 1;
            queue[queueTail++] = child;
        }
    }

    for (int iter = 0; iter < 10; iter++)
    {
        for (int a = 0; a < atomCount; a++)
        {
            for (int b = a + 1; b < atomCount; b++)
            {
                int bondType = GetBondValue(bondMatrix, a, b);
                float3 delta = atomPositions[b] - atomPositions[a];
                float dist = max(length(delta), 1e-4f);

                if (bondType != BOND_UNKNOWN)
                {
                    float target = bondLength;
                    float stiffness = 0.2f;
                    float3 correction = delta * ((dist - target) / dist) * stiffness;
                    if (a != 0)
                        atomPositions[a] += correction * 0.5f;
                    atomPositions[b] -= correction * 0.5f;
                }
                else if (dist < bondLength * 0.75f)
                {
                    float3 repulse = delta * ((bondLength * 0.75f - dist) / dist) * 0.08f;
                    if (a != 0)
                        atomPositions[a] -= repulse;
                    atomPositions[b] += repulse;
                }
            }
        }
    }
}

[numthreads(32, 1, 1)]
void CSGenerateCartoonMesh(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int meshIdx = dispatchThreadID.x;
    if (meshIdx >= selectedCount)
        return;
    int molIdx = selectedMolIndexBuffer[meshIdx];
    if (molIdx < 0 || molIdx >= batchSize)
        return;

    // 1. 璇诲彇SMILES瀛楃涓?
    int smilesChars[SMILES_MAX_LENGTH];
    for (int i = 0; i < SMILES_MAX_LENGTH; i++)
    {
        if (useSmilesTextureInput != 0)
            smilesChars[i] = (int)round(smilesInputTexture[int2(i, molIdx)].r * 255.0f);
        else
            smilesChars[i] = smilesInputBuffer[molIdx * SMILES_MAX_LENGTH + i];
    }

    // 2. 瑙ｆ瀽SMILES
    int atomTypes[MAX_ATOM_COUNT];
    int atomCount = 0;
    int bondMatrix[MAX_ATOM_COUNT * MAX_ATOM_COUNT];
    int bondCount = 0;
    ParseSMILESGraph(smilesChars, atomTypes, atomCount, bondMatrix, bondCount);
    atomCountOutputBuffer[meshIdx] = atomCount;
    bondCountOutputBuffer[meshIdx] = bondCount;

    //// 浠呭鐞員op-K鍒嗗�?
    //if(molIdx >= topK || atomCount <= 1) return;
    if (atomCount <= 1)
    {
        atomCountOutputBuffer[meshIdx] = 0;
        bondCountOutputBuffer[meshIdx] = 0;
        return;
    }

    // 3. 璁＄畻鍘熷瓙浣嶇疆锛堝熀浜庢嫇鎵戝浘鐨勫眰娆″竷灞€ + 杞婚噺鏉惧紱�?
    float3 atomPositions[MAX_ATOM_COUNT];
    BuildAtomLayout(bondMatrix, atomCount, atomPositions);

    // 4. 璁＄畻褰撳墠鍒嗗瓙鐨凚uffer鍋忕Щ�?
    int verticesPerAtom = (sphereSegments + 1) * (sphereSegments + 1);
    int verticesPerBond = 2 * (cylinderSegments + 1);
    int indicesPerAtom = sphereSegments * sphereSegments * 6;
    int indicesPerBond = cylinderSegments * 6;

    int totalVertices = MAX_ATOM_COUNT * verticesPerAtom + maxBondCount * verticesPerBond;
    int totalIndices = MAX_ATOM_COUNT * indicesPerAtom + maxBondCount * indicesPerBond;
    int vertexOffset = meshIdx * totalVertices;
    int indexOffset = meshIdx * totalIndices;

    int vCount = 0;
    int iCount = 0;

    // 5. 鐢熸垚鍘熷瓙�?
    for (int a = 0; a < atomCount; a++)
    {
        GenerateAtomSphere(atomPositions[a], atomTypes[a], vertexOffset, indexOffset, vCount, iCount);
    }
    
    //vertexOffset += MAX_ATOM_COUNT * verticesPerAtom;
    //indexOffset += MAX_ATOM_COUNT * indicesPerAtom;

    // 6. 鐢熸垚鍖栧閿锛堟寜鐪熷疄鎷撴墤杈硅緭鍑猴級
    int emittedBondCount = 0;
    for (int a = 0; a < atomCount; a++)
    {
        for (int b = a + 1; b < atomCount; b++)
        {
            if (GetBondValue(bondMatrix, a, b) == BOND_UNKNOWN)
                continue;

            float4 color = (GetAtomColor(atomTypes[a]) + GetAtomColor(atomTypes[b])) * 0.5f;
            GenerateBondCylinder(atomPositions[a], atomPositions[b], color, vertexOffset, indexOffset, vCount, iCount);
            emittedBondCount++;
        }
    }

    atomCountOutputBuffer[meshIdx] = atomCount;
    bondCountOutputBuffer[meshIdx] = emittedBondCount;
}
