#pragma kernel CSGenerateMorganFP
#pragma kernel CSGenerateMorganFPLegacy
#pragma enable_d3d11_debug_symbols

#include "AtomCommon.hlsl"


int batchSize; 
int currentBatchSize; 
int moleculeOffset; 
int morganRadius; 
int packOutput;
int useSmilesTextureInput;
int graphMaxNeighbors;



StructuredBuffer<int> smilesInputBuffer;
Texture2D<float4> smilesInputTexture;
StructuredBuffer<int> graphAtomCountBuffer;
StructuredBuffer<int> graphAtomTypeBuffer;
StructuredBuffer<int> graphDegreeBuffer;
StructuredBuffer<int> graphNeighborIndexBuffer;
StructuredBuffer<int> graphNeighborBondTypeBuffer;

RWStructuredBuffer<uint> fpOutputBuffer;

void ComputeMorganFPLegacy(
    in int atomTypes[MAX_ATOM_COUNT],
    in int atomCount,
    out int fp[FP_SIZE])
{
    for (int i = 0; i < FP_SIZE; i++)
        fp[i] = 0;

    for (int atomIdx = 0; atomIdx < atomCount; atomIdx++)
    {
        for (int r = 0; r <= morganRadius; r++)
        {
            uint atomType = (uint)atomTypes[atomIdx];
            uint neighborCount = 0u;

            int startIdx = max(0, atomIdx - r);
            int endIdx = min(atomCount - 1, atomIdx + r);
            for (int nIdx = startIdx; nIdx <= endIdx; nIdx++)
            {
                if (nIdx == atomIdx)
                    continue;
                neighborCount++;
            }

            uint3 feature = uint3(atomType, (uint)r, neighborCount);
            uint fpIdx = Hash(feature);
            fp[fpIdx] = 1;
        }
    }
}

void ComputeMorganFPGraph(int molIdx, int atomCount, out int fp[FP_SIZE])
{
    for (int i = 0; i < FP_SIZE; i++)
        fp[i] = 0;

    int atomBase = molIdx * MAX_ATOM_COUNT;

    for (int atomIdx = 0; atomIdx < atomCount; atomIdx++)
    {
        int centerDegree = graphDegreeBuffer[atomBase + atomIdx];
        int centerAtomType = graphAtomTypeBuffer[atomBase + atomIdx];
        int centerNeighborBase = (atomBase + atomIdx) * graphMaxNeighbors;

        for (int r = 0; r <= morganRadius; r++)
        {
            int totalVisited = 1;
            uint envHash = Hash(uint3((uint)centerAtomType, (uint)r, (uint)centerDegree));
            int firstHopCount = 0;
            int secondHopCount = 0;

            int firstHopLimit = min(centerDegree, graphMaxNeighbors);
            for (int neighborSlot = 0; neighborSlot < firstHopLimit; neighborSlot++)
            {
                int neighbor = graphNeighborIndexBuffer[centerNeighborBase + neighborSlot];
                int bondType = graphNeighborBondTypeBuffer[centerNeighborBase + neighborSlot];
                if (neighbor < 0 || neighbor >= atomCount || bondType == BOND_UNKNOWN)
                    continue;

                firstHopCount++;
                totalVisited++;
                int neighborDegree = graphDegreeBuffer[atomBase + neighbor];
                int neighborAtomType = graphAtomTypeBuffer[atomBase + neighbor];

                uint packedFeature =
                    (uint)neighborAtomType * 131u +
                    (uint)neighborDegree * 17u +
                    (uint)(bondType + 1) * 31u;
                envHash = MixHash(envHash, packedFeature);

                if (r < 2)
                    continue;

                int secondNeighborBase = (atomBase + neighbor) * graphMaxNeighbors;
                int secondHopLimit = min(neighborDegree, graphMaxNeighbors);
                int sampledSecondHop = 0;
                for (int neighbor2Slot = 0; neighbor2Slot < secondHopLimit && sampledSecondHop < 6; neighbor2Slot++)
                {
                    int neighbor2 = graphNeighborIndexBuffer[secondNeighborBase + neighbor2Slot];
                    int bondType2 = graphNeighborBondTypeBuffer[secondNeighborBase + neighbor2Slot];
                    if (neighbor2 < 0 || neighbor2 >= atomCount || neighbor2 == atomIdx || neighbor2 == neighbor || bondType2 == BOND_UNKNOWN)
                        continue;

                    secondHopCount++;
                    sampledSecondHop++;
                    int neighbor2Degree = graphDegreeBuffer[atomBase + neighbor2];
                    int neighbor2AtomType = graphAtomTypeBuffer[atomBase + neighbor2];

                    uint packedFeature2 =
                        (uint)neighbor2AtomType * 193u +
                        (uint)neighbor2Degree * 23u +
                        (uint)(bondType2 + 1) * 47u;
                    envHash = MixHash(envHash, packedFeature2);
                }
            }

            envHash = MixHash(envHash, (uint)firstHopCount * 59u);
            if (r >= 2)
                envHash = MixHash(envHash, (uint)secondHopCount * 83u);
            envHash = MixHash(envHash, (uint)totalVisited * 97u);
            fp[envHash % FP_SIZE] = 1;
        }
    }
}

void PackMorganFP(in int fp[FP_SIZE], out uint packedFp[FP_SIZE / 32])
{
    for (int wordIdx = 0; wordIdx < FP_SIZE / 32; wordIdx++)
        packedFp[wordIdx] = 0u;

    for (int bitIdx = 0; bitIdx < FP_SIZE; bitIdx++)
    {
        if (fp[bitIdx] == 0)
            continue;

        int wordIdx = bitIdx >> 5;
        int localBit = bitIdx & 31;
        packedFp[wordIdx] |= (1u << localBit);
    }
}

void ReadSmilesChars(int molIdx, out int smilesChars[SMILES_MAX_LENGTH])
{
    for (int i = 0; i < SMILES_MAX_LENGTH; i++)
    {
        if (useSmilesTextureInput != 0)
            smilesChars[i] = (int)(smilesInputTexture[int2(i, molIdx)].r * 255.0f);
        else
            smilesChars[i] = smilesInputBuffer[molIdx * SMILES_MAX_LENGTH + i];
    }
}

void ZeroMorganOutput(int molIdx)
{
    int zeroCount = packOutput != 0 ? (FP_SIZE / 32) : FP_SIZE;
    int zeroStride = packOutput != 0 ? (FP_SIZE / 32) : FP_SIZE;
    for (int i = 0; i < zeroCount; i++)
    {
        fpOutputBuffer[molIdx * zeroStride + i] = 0u;
    }
}

void WriteMorganOutput(int molIdx, in int fp[FP_SIZE])
{
    if (packOutput != 0)
    {
        uint packedFp[FP_SIZE / 32];
        PackMorganFP(fp, packedFp);

        for (int i = 0; i < FP_SIZE / 32; i++)
        {
            int outputIdx = molIdx * (FP_SIZE / 32) + i;
            fpOutputBuffer[outputIdx] = packedFp[i];
        }
    }
    else
    {
        for (int i = 0; i < FP_SIZE; i++)
        {
            int outputIdx = molIdx * FP_SIZE + i;
            fpOutputBuffer[outputIdx] = (uint)fp[i];
        }
    }
}



[numthreads(32, 1, 1)]
void CSGenerateMorganFPLegacy(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int localIdx = dispatchThreadID.x;
    if (localIdx >= currentBatchSize)
        return;
    int molIdx = moleculeOffset + localIdx;
    if (molIdx >= batchSize)
        return;

    int smilesChars[SMILES_MAX_LENGTH];
    ReadSmilesChars(molIdx, smilesChars);

    int atomTypes[MAX_ATOM_COUNT];
    int atomCount;
    ParseSMILESLegacy(smilesChars, atomTypes, atomCount);

    if (atomCount <= 0)
    {
        ZeroMorganOutput(molIdx);
        return;
    }

    int fp[FP_SIZE];
    ComputeMorganFPLegacy(atomTypes, atomCount, fp);
    WriteMorganOutput(molIdx, fp);
}



[numthreads(32, 1, 1)]
void CSGenerateMorganFP(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int localIdx = dispatchThreadID.x;
    if (localIdx >= currentBatchSize)
        return;
    int molIdx = moleculeOffset + localIdx;
    if (molIdx >= batchSize)
        return;

    int smilesChars[SMILES_MAX_LENGTH];
    ReadSmilesChars(molIdx, smilesChars);

    int atomCount = graphAtomCountBuffer[molIdx];

    if (atomCount <= 0)
    {
        ZeroMorganOutput(molIdx);
        return;
    }

    int fp[FP_SIZE];
    ComputeMorganFPGraph(molIdx, atomCount, fp);
    WriteMorganOutput(molIdx, fp);
}
