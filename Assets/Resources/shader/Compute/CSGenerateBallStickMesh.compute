#pragma optimize("", off)
#pragma kernel CSBuildBallStickGraphBatch
#pragma kernel CSBuildBallStickLayoutBatch
#pragma kernel CSGenerateBallStickMesh
#pragma enable_d3d11_debug_symbols

#include "AtomCommon.hlsl"

//#define SMILES_GRAPH_DEBUG 0

// Batch mode parses SMILES on the GPU in two preprocessing stages.
int batchSize;
int selectedCount;
int useSmilesTextureInput;
int smilesMaxLength;
int sphereSegments;
int cylinderSegments;
float bondLength;
float atomRadius;
float bondRadius;
int maxBondCount;
int vertexCapacity;
#if SMILES_GRAPH_DEBUG
int enableGraphDebug;
#endif

StructuredBuffer<int> smilesInputBuffer;
Texture2D<float4> smilesInputTexture;
StructuredBuffer<int> selectedMolIndexBuffer;
StructuredBuffer<int> meshAtomStartBuffer;
RWStructuredBuffer<int> meshAtomCountInputBuffer;
StructuredBuffer<int> meshBondStartBuffer;
RWStructuredBuffer<int> meshBondCountInputBuffer;
RWStructuredBuffer<int> atomTypeInputBuffer;
RWStructuredBuffer<float3> atomPositionInputBuffer;
RWStructuredBuffer<int2> bondInputBuffer;
RWStructuredBuffer<float3> vertexPosNormalBuffer;
RWStructuredBuffer<float4> vertexOutputBuffer_color;
RWStructuredBuffer<int> indexOutputBuffer;
#if SMILES_GRAPH_DEBUG
RWStructuredBuffer<int> graphDebugBuffer;
#endif

bool TryMapSimpleAtom(int c0, int c1, out int atomType, out int consumed)
{
    atomType = ATOM_TYPE_UNKNOWN;
    consumed = 0;

    if (c0 == 0)
        return false;

    if (c0 == 'C' && c1 == 'l') { atomType = ATOM_TYPE_Cl; consumed = 2; return true; }
    if (c0 == 'B' && c1 == 'r') { atomType = ATOM_TYPE_Br; consumed = 2; return true; }
    if (c0 == 'S' && c1 == 'i') { atomType = ATOM_TYPE_Si; consumed = 2; return true; }
    if (c0 == 'A' && c1 == 's') { atomType = ATOM_TYPE_As; consumed = 2; return true; }
    if (c0 == 'S' && c1 == 'e') { atomType = ATOM_TYPE_Se; consumed = 2; return true; }

    consumed = 1;
    switch (c0)
    {
        case 'H': atomType = ATOM_TYPE_H; return true;
        case 'B': atomType = ATOM_TYPE_B; return true;
        case 'C': atomType = ATOM_TYPE_C; return true;
        case 'N': atomType = ATOM_TYPE_N; return true;
        case 'O': atomType = ATOM_TYPE_O; return true;
        case 'F': atomType = ATOM_TYPE_F; return true;
        case 'P': atomType = ATOM_TYPE_P; return true;
        case 'S': atomType = ATOM_TYPE_S; return true;
        case 'I': atomType = ATOM_TYPE_I; return true;
        case 'c': atomType = ATOM_TYPE_c; return true;
        case 'n': atomType = ATOM_TYPE_n; return true;
        case 'o': atomType = ATOM_TYPE_o; return true;
        case 's': atomType = ATOM_TYPE_s; return true;
        case 'p': atomType = ATOM_TYPE_p; return true;
        default:
            return false;
    }
}

int ReadSmilesChar(int molIdx, int charIdx)
{
    if (charIdx < 0 || charIdx >= smilesMaxLength)
        return 0;
    return useSmilesTextureInput != 0
        ? (int)round(smilesInputTexture[int2(charIdx, molIdx)].r * 255.0f)
        : smilesInputBuffer[molIdx * smilesMaxLength + charIdx];
}

bool TryParseBracketAtomToken(int molIdx, int startIdx, out int mappedType, out int nextIdx)
{
    mappedType = ATOM_TYPE_UNKNOWN;
    nextIdx = startIdx + 1;

    int firstInside = ReadSmilesChar(molIdx, startIdx + 1);
    bool plausibleStart =
        (firstInside >= 48 && firstInside <= 57) || // '0'..'9'
        (firstInside >= 65 && firstInside <= 90) || // 'A'..'Z'
        (firstInside >= 97 && firstInside <= 122) || // 'a'..'z'
        firstInside == 64 || firstInside == 43 || firstInside == 45; // '@' '+' '-'
    if (!plausibleStart)
        return false;

    int end = startIdx + 1;
    bool foundCloseBracket = false;
    int maxBracketSpan = 24;
    while (end < smilesMaxLength && (end - startIdx) <= maxBracketSpan)
    {
        int ce = ReadSmilesChar(molIdx, end);
        if (ce == 0)
            break;
        if (ce == 93) // ']'
        {
            foundCloseBracket = true;
            break;
        }
        end++;
    }
    if (!foundCloseBracket)
        return false;

    int p = startIdx + 1;
    while (p < end)
    {
        int cp = ReadSmilesChar(molIdx, p);
        if (cp < 48 || cp > 57) // skip isotope digits
            break;
        p++;
    }
    if (p >= end)
        return false;

    int ca = ReadSmilesChar(molIdx, p);
    int cb = (p + 1 < end) ? ReadSmilesChar(molIdx, p + 1) : 0;
    int consumedTmp;
    if (!TryMapSimpleAtom(ca, cb, mappedType, consumedTmp))
        return false;

    nextIdx = min(end + 1, smilesMaxLength);
    return true;
}

bool TryAppendBracketAtom(int molIdx, int startIdx, int atomStart, inout int2 localBonds[128], int localBondCap, inout int atomCount, inout int currentAtom, inout int pendingBond, inout int writeBondCount, out int nextIdx)
{
    nextIdx = startIdx + 1;
    int mappedType;
    if (!TryParseBracketAtomToken(molIdx, startIdx, mappedType, nextIdx))
        return false;

    int newAtom = atomCount;
    atomTypeInputBuffer[atomStart + newAtom] = mappedType;
    atomPositionInputBuffer[atomStart + newAtom] = float3(0, 0, 0);
    if (currentAtom >= 0 && writeBondCount < localBondCap)
        localBonds[writeBondCount++] = int2(currentAtom, newAtom);
    currentAtom = newAtom;
    atomCount++;
    pendingBond = 0;
    return true;
}

float Hash01(uint seed)
{
    return frac(sin(seed * 12.9898f + 78.233f) * 43758.5453f);
}

static const int PACKED_ATOM_WORDS = (MAX_ATOM_COUNT + 3) / 4;
static const int PACKED_PLACED_WORDS = (MAX_ATOM_COUNT + 31) / 32;
static const int PACKED_CHILD_WORDS = (MAX_GRAPH_NEIGHBORS + 3) / 4;
static const int RING_SLOT_COUNT = 16;
static const int MAX_RING_ID = 100;
#if SMILES_GRAPH_DEBUG
static const int GRAPH_DEBUG_STRIDE = 16;
#endif

int PackedByteGet(int packed[PACKED_ATOM_WORDS], int idx)
{
    int word = packed[idx >> 2];
    int shift = (idx & 3) * 8;
    return (word >> shift) & 0xFF;
}

void PackedByteSet(inout int packed[PACKED_ATOM_WORDS], int idx, int value)
{
    int wi = idx >> 2;
    int shift = (idx & 3) * 8;
    int mask = 0xFF << shift;
    packed[wi] = (packed[wi] & ~mask) | ((value & 0xFF) << shift);
}

int PackedByteGetSmall(int packed[PACKED_CHILD_WORDS], int idx)
{
    int word = packed[idx >> 2];
    int shift = (idx & 3) * 8;
    return (word >> shift) & 0xFF;
}

void PackedByteSetSmall(inout int packed[PACKED_CHILD_WORDS], int idx, int value)
{
    int wi = idx >> 2;
    int shift = (idx & 3) * 8;
    int mask = 0xFF << shift;
    packed[wi] = (packed[wi] & ~mask) | ((value & 0xFF) << shift);
}

bool PackedBitGet(int bits[PACKED_PLACED_WORDS], int idx)
{
    int wi = idx >> 5;
    int bi = idx & 31;
    return ((bits[wi] >> bi) & 1) != 0;
}

void PackedBitSet(inout int bits[PACKED_PLACED_WORDS], int idx, bool value)
{
    int wi = idx >> 5;
    int bi = idx & 31;
    int mask = 1 << bi;
    if (value)
        bits[wi] |= mask;
    else
        bits[wi] &= ~mask;
}

[numthreads(32, 1, 1)]
void CSBuildBallStickGraphBatch(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int meshIdx = dispatchThreadID.x;
    if (meshIdx >= selectedCount)
        return;

    int atomStart = meshAtomStartBuffer[meshIdx];
    int bondStart = meshBondStartBuffer[meshIdx];

    int ringAtomById[MAX_RING_ID];
    int branchStack[16];
    for (int r = 0; r < MAX_RING_ID; r++) { ringAtomById[r] = -1; }
    int2 localBonds[128];
    int localBondCap = min(maxBondCount, 128);
    int branchTop = 0;
    int atomCount = 0;
    int writeBondCount = 0;
    int currentAtom = -1;
    int pendingBond = 0;
#if SMILES_GRAPH_DEBUG
    int dbgDigitToken = 0;
    int dbgPercentToken = 0;
    int dbgRingOpen = 0;
    int dbgRingClose = 0;
#endif
    int molIdx = selectedMolIndexBuffer[meshIdx];
    if (molIdx < 0 || molIdx >= batchSize)
    {
        meshAtomCountInputBuffer[meshIdx] = 0;
        meshBondCountInputBuffer[meshIdx] = 0;
        return;
    }
    int i = 0;
    while (i < smilesMaxLength && atomCount < MAX_ATOM_COUNT)
    {
        int c0 = ReadSmilesChar(molIdx, i);
        int c1 = ReadSmilesChar(molIdx, i + 1);
        if (c0 == 0)
            break;

        else if (c0 == '=') { pendingBond = 1; i++; continue; }
        else if (c0 == '#') { pendingBond = 2; i++; continue; }
        else if (c0 == ':') { pendingBond = 3; i++; continue; }
        else if (c0 == '-') { pendingBond = 0; i++; continue; }
        else if (c0 == '.') { currentAtom = -1; pendingBond = 0; i++; continue; }
        else if (c0 == 47 || c0 == 92 || c0 == 64) { i++; continue; } // '/', '\\', '@'
        else if (c0 == '%')
        {
#if SMILES_GRAPH_DEBUG
            dbgPercentToken++;
#endif
            int d1 = ReadSmilesChar(molIdx, i + 1);
            int d2 = ReadSmilesChar(molIdx, i + 2);
            if (d1 >= '0' && d1 <= '9' && d2 >= '0' && d2 <= '9')
            {
                int ringNumber = (d1 - '0') * 10 + (d2 - '0');
                if (currentAtom >= 0)
                {
                    if (ringNumber >= 0 && ringNumber < MAX_RING_ID)
                    {
                        int a = ringAtomById[ringNumber];
                        if (a >= 0)
                        {
                            if (a != currentAtom && writeBondCount < maxBondCount)
                                bondInputBuffer[bondStart + writeBondCount++] = int2(a, currentAtom);
                            ringAtomById[ringNumber] = -1;
#if SMILES_GRAPH_DEBUG
                            dbgRingClose++;
#endif
                        }
                        else
                        {
                            ringAtomById[ringNumber] = currentAtom;
#if SMILES_GRAPH_DEBUG
                            dbgRingOpen++;
#endif
                        }
                    }
                }
                pendingBond = 0;
                i += 3;
                continue;
            }
        }
        else if (c0 == '(')
        {
            if (branchTop < 16)
                branchStack[branchTop++] = currentAtom;
            i++;
            continue;
        }
        else if (c0 == ')')
        {
            if (branchTop > 0)
                currentAtom = branchStack[--branchTop];
            i++;
            continue;
        }
#if ALLOW_C0_91        
        else if (c0 == 91) // '['
        {
            int nextIdx;
            if (TryAppendBracketAtom(molIdx, i, atomStart, localBonds, localBondCap, atomCount, currentAtom, pendingBond, writeBondCount, nextIdx))
            {
                i = nextIdx;
                continue;
            }
            i++;
            continue;
        }
#endif
        else if (c0 >= '0' && c0 <= '9')
        {
#if SMILES_GRAPH_DEBUG
            dbgDigitToken++;
#endif
            int ringNumber = c0 - '0';
            if (currentAtom >= 0)
            {
                if (ringNumber >= 0 && ringNumber < MAX_RING_ID)
                {
                    int a = ringAtomById[ringNumber];
                    if (a >= 0)
                    {
                                if (a != currentAtom && writeBondCount < localBondCap)
                                    localBonds[writeBondCount++] = int2(a, currentAtom);
                        ringAtomById[ringNumber] = -1;
#if SMILES_GRAPH_DEBUG
                        dbgRingClose++;
#endif
                    }
                    else
                    {
                        ringAtomById[ringNumber] = currentAtom;
#if SMILES_GRAPH_DEBUG
                        dbgRingOpen++;
#endif
                    }
                }
            }
            pendingBond = 0;
            i++;
            continue;
        }

        int atomType = ATOM_TYPE_UNKNOWN;
        int consumed = 1;
        if (TryMapSimpleAtom(c0, c1, atomType, consumed))
        {
            int newAtom = atomCount;
            atomTypeInputBuffer[atomStart + newAtom] = atomType;
            atomPositionInputBuffer[atomStart + newAtom] = float3(0, 0, 0);
            if (currentAtom >= 0 && writeBondCount < localBondCap)
                localBonds[writeBondCount++] = int2(currentAtom, newAtom);
            currentAtom = newAtom;
            atomCount++;
            pendingBond = 0;
            i += consumed;
            continue;
        }

        i++;
    }

    for (int atomIdx = atomCount; atomIdx < MAX_ATOM_COUNT; atomIdx++)
    {
        atomTypeInputBuffer[atomStart + atomIdx] = 0;
        atomPositionInputBuffer[atomStart + atomIdx] = float3(0, 0, 0);
    }

#if SMILES_GRAPH_DEBUG
    int dbgBondPreCompact = writeBondCount;
    int dbgSkipSelf = 0;
    int dbgSkipRange = 0;
    int dbgSkipDup = 0;
    int dbgMinEnd = 2147483647;
    int dbgMaxEnd = -2147483647;
#endif
    int compactBondCount = 0;
    for (int bi = 0; bi < writeBondCount; bi++)
    {
        int2 b = localBonds[bi];
        int a = b.x;
        int c = b.y;
#if SMILES_GRAPH_DEBUG
        dbgMinEnd = min(dbgMinEnd, min(a, c));
        dbgMaxEnd = max(dbgMaxEnd, max(a, c));
#endif
        if (a == c) { 
#if SMILES_GRAPH_DEBUG
            dbgSkipSelf++; 
#endif
            continue; 
        }
        if (a < 0 || c < 0 || a >= atomCount || c >= atomCount) { 
#if SMILES_GRAPH_DEBUG
            dbgSkipRange++; 
#endif
            continue; 
        }
        int lo = min(a, c);
        int hi = max(a, c);

        bool dup = false;
        for (int pj = 0; pj < compactBondCount; pj++)
        {
            int2 p = localBonds[pj];
            int plo = min(p.x, p.y);
            int phi = max(p.x, p.y);
            if (plo == lo && phi == hi) { dup = true; break; }
        }
        if (dup) { 
#if SMILES_GRAPH_DEBUG
            dbgSkipDup++; 
#endif
            continue; 
        }

        if (compactBondCount < localBondCap)
            localBonds[compactBondCount++] = int2(lo, hi);
    }
    writeBondCount = compactBondCount;
#if SMILES_GRAPH_DEBUG
    int dbgBondPostCompact = writeBondCount;
#endif

    if (atomCount > 1 && writeBondCount == 0)
    {
        int fallback = min(atomCount - 1, localBondCap);
        for (int i = 1; i <= fallback; i++)
            localBonds[i - 1] = int2(i - 1, i);
        writeBondCount = fallback;
    }

    // Ensure graph connectivity from atom 0 to avoid disconnected-component-only layouts in batch mode.
    if (atomCount > 1 && writeBondCount > 0)
    {
        bool visited[MAX_ATOM_COUNT];
        int bfsQueue[MAX_ATOM_COUNT];
        for (int a = 0; a < atomCount; a++) visited[a] = false;

        int qHead = 0;
        int qTail = 0;
        visited[0] = true;
        bfsQueue[qTail++] = 0;
        while (qHead < qTail)
        {
            int cur = bfsQueue[qHead++];
            for (int bi = 0; bi < writeBondCount; bi++)
            {
                int2 b = localBonds[bi];
                int n = -1;
                if (b.x == cur) n = b.y;
                else if (b.y == cur) n = b.x;
                if (n < 0 || n >= atomCount || visited[n]) continue;
                visited[n] = true;
                bfsQueue[qTail++] = n;
            }
        }

        for (int seed = 0; seed < atomCount; seed++)
        {
            if (visited[seed]) continue;

            int anchor = seed - 1;
            while (anchor >= 0 && !visited[anchor]) anchor--;
            if (anchor < 0) anchor = 0;

            bool exists = false;
            for (int bi = 0; bi < writeBondCount; bi++)
            {
                int2 b = localBonds[bi];
                if ((b.x == anchor && b.y == seed) || (b.x == seed && b.y == anchor))
                {
                    exists = true;
                    break;
                }
            }
            if (!exists && writeBondCount < localBondCap)
                localBonds[writeBondCount++] = int2(anchor, seed);

            // Flood-fill this component as reachable now.
            qHead = 0;
            qTail = 0;
            if (!visited[seed])
            {
                visited[seed] = true;
                bfsQueue[qTail++] = seed;
            }
            while (qHead < qTail)
            {
                int cur = bfsQueue[qHead++];
                for (int bi = 0; bi < writeBondCount; bi++)
                {
                    int2 b = localBonds[bi];
                    int n = -1;
                    if (b.x == cur) n = b.y;
                    else if (b.y == cur) n = b.x;
                    if (n < 0 || n >= atomCount || visited[n]) continue;
                    visited[n] = true;
                    bfsQueue[qTail++] = n;
                }
            }
        }
    }
#if SMILES_GRAPH_DEBUG
    int dbgBondPostConnectivity = writeBondCount;
#endif

    int outCount = min(writeBondCount, maxBondCount);
    for (int bondIdx = 0; bondIdx < maxBondCount; bondIdx++)
    {
        if (bondIdx < outCount && bondIdx < localBondCap)
            bondInputBuffer[bondStart + bondIdx] = localBonds[bondIdx];
        else
            bondInputBuffer[bondStart + bondIdx] = int2(0, 0);
    }

    meshAtomCountInputBuffer[meshIdx] = atomCount;
    meshBondCountInputBuffer[meshIdx] = outCount;
#if SMILES_GRAPH_DEBUG
    if (enableGraphDebug != 0)
    {
        int baseIdx = meshIdx * GRAPH_DEBUG_STRIDE;
        graphDebugBuffer[baseIdx + 0] = dbgDigitToken;
        graphDebugBuffer[baseIdx + 1] = dbgPercentToken;
        graphDebugBuffer[baseIdx + 2] = dbgRingOpen;
        graphDebugBuffer[baseIdx + 3] = dbgRingClose;
        graphDebugBuffer[baseIdx + 4] = dbgBondPreCompact;
        graphDebugBuffer[baseIdx + 5] = dbgBondPostCompact;
        graphDebugBuffer[baseIdx + 6] = dbgBondPostConnectivity;
        graphDebugBuffer[baseIdx + 7] = atomCount;
        graphDebugBuffer[baseIdx + 8] = dbgSkipSelf;
        graphDebugBuffer[baseIdx + 9] = dbgSkipRange;
        graphDebugBuffer[baseIdx + 10] = dbgSkipDup;
        graphDebugBuffer[baseIdx + 11] = dbgMinEnd;
        graphDebugBuffer[baseIdx + 12] = dbgMaxEnd;
        graphDebugBuffer[baseIdx + 13] = atomStart;
        graphDebugBuffer[baseIdx + 14] = bondStart;
        graphDebugBuffer[baseIdx + 15] = maxBondCount;
    }
#endif
}

[numthreads(32, 1, 1)]
void CSBuildBallStickLayoutBatch(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int meshIdx = dispatchThreadID.x;
    if (meshIdx >= selectedCount)
        return;

    int atomStart = meshAtomStartBuffer[meshIdx];
    int atomCount = meshAtomCountInputBuffer[meshIdx];
    int bondStart = meshBondStartBuffer[meshIdx];
    int bondCount = meshBondCountInputBuffer[meshIdx];
    if (atomCount <= 0)
        return;

    float3 positions[MAX_ATOM_COUNT];
    int parent[MAX_ATOM_COUNT];
    int depth[MAX_ATOM_COUNT];
    bool placed[MAX_ATOM_COUNT];
    int queue[MAX_ATOM_COUNT];
    for (int i = 0; i < atomCount; i++)
    {
        positions[i] = float3(0, 0, 0);
        parent[i] = -1;
        depth[i] = 0;
        placed[i] = false;
    }

    int componentCount = 0;
    for (int seed = 0; seed < atomCount; seed++)
    {
        if (placed[seed])
            continue;

        float3 componentAnchor = float3(
            ((componentCount % 3) - 1) * bondLength * 2.2f,
            (componentCount / 3) * bondLength * 1.8f,
            ((componentCount & 1) == 0 ? 0.7f : -0.7f) * bondLength);
        positions[seed] = componentAnchor;
        placed[seed] = true;
        int qHead = 0;
        int qTail = 0;
        queue[qTail++] = seed;

        while (qHead < qTail)
        {
            int current = queue[qHead++];
            int children[MAX_GRAPH_NEIGHBORS];
            int childCount = 0;
            for (int b = 0; b < bondCount; b++)
            {
                int2 bond = bondInputBuffer[bondStart + b];
                int n = -1;
                if (bond.x == current) n = bond.y;
                else if (bond.y == current) n = bond.x;
                if (n < 0 || n >= atomCount || placed[n])
                    continue;

                bool exists = false;
                for (int c = 0; c < childCount; c++)
                {
                    if (children[c] == n) { exists = true; break; }
                }
                if (!exists && childCount < MAX_GRAPH_NEIGHBORS)
                    children[childCount++] = n;
            }

            float3 parentDir = float3(1, 0, 0);
            if (parent[current] >= 0)
            {
                parentDir = positions[current] - positions[parent[current]];
                float d = length(parentDir);
                parentDir = d < 1e-6f ? float3(1, 0, 0) : parentDir / d;
            }
            float3 refUp = abs(parentDir.y) < 0.9f ? float3(0, 1, 0) : float3(1, 0, 0);
            float3 tangent = normalize(cross(parentDir, refUp));
            float3 bitangent = normalize(cross(parentDir, tangent));
            float spread = childCount > 1 ? 1.5f : 0.0f;
        for (int c = 0; c < childCount; c++)
        {
            int child = children[c];
            float t = childCount == 1 ? 0.5f : (float)c / (childCount - 1);
                float azimuth = lerp(-spread, spread, t);
                float elev = ((depth[current] + c) & 1) == 0 ? 0.45f : -0.45f;
                float3 dir = normalize(parentDir * cos(elev) + tangent * (sin(elev) * cos(azimuth)) + bitangent * (sin(elev) * sin(azimuth)));
                float3 offset = dir * bondLength;
            positions[child] = positions[current] + offset;
            parent[child] = current;
            depth[child] = depth[current] + 1;
            placed[child] = true;
            queue[qTail++] = child;
        }
        }
        componentCount++;
    }

    for (int iter = 0; iter < 4; iter++)
    {
        for (int bondIdx = 0; bondIdx < bondCount; bondIdx++)
        {
            int2 bond = bondInputBuffer[bondStart + bondIdx];
            int atomA = clamp(bond.x, 0, atomCount - 1);
            int atomB = clamp(bond.y, 0, atomCount - 1);
            if (atomA == atomB)
                continue;

            float3 pa = positions[atomA];
            float3 pb = positions[atomB];
            float3 delta = pb - pa;
            float dist = max(length(delta), 1e-4f);
            float3 correction = delta * ((dist - bondLength) / dist) * 0.18f;
            if (atomA != 0)
                pa += correction * 0.5f;
            pb -= correction * 0.5f;
            positions[atomA] = pa;
            positions[atomB] = pb;
        }

        for (int a = 0; a < atomCount; a++)
        {
            for (int b = a + 1; b < atomCount; b++)
            {
                bool bonded = false;
                for (int bondIdx = 0; bondIdx < bondCount; bondIdx++)
                {
                    int2 bond = bondInputBuffer[bondStart + bondIdx];
                    if ((bond.x == a && bond.y == b) || (bond.x == b && bond.y == a))
                    {
                        bonded = true;
                        break;
                    }
                }
                if (bonded) continue;

                float3 pa = positions[a];
                float3 pb = positions[b];
                float3 delta = pb - pa;
                float dist = max(length(delta), 1e-4f);
                float minDist = bondLength * 0.75f;
                if (dist < minDist)
                {
                    float3 repel = delta * ((minDist - dist) / dist) * 0.06f;
                    if (a != 0) pa -= repel;
                    pb += repel;
                    positions[a] = pa;
                    positions[b] = pb;
                }
            }
        }
    }

    for (int i = 0; i < atomCount; i++)
        atomPositionInputBuffer[atomStart + i] = positions[i];
}

// Emit a UV sphere for a single atom.
void GenerateAtomSphere(float3 center, int type, int vertexOffset, int indexOffset, inout int vCount, inout int iCount)
{
    float radius = atomRadius > 0 ? atomRadius * 0.78f : GetAtomRadius(type) * 0.42f;
    float4 color = GetAtomColor(type);
    float thetaStep = 2 * 3.1415926f / sphereSegments;
    float phiStep = 3.1415926f / sphereSegments;

    int beginVCount = vCount;
    
    for (int y = 0; y <= sphereSegments; y++)
    {
        float phi = y * phiStep;
        float sinPhi = sin(phi);
        float cosPhi = cos(phi);

        for (int x = 0; x <= sphereSegments; x++)
        {
            float theta = x * thetaStep;
            float sinTheta = sin(theta);
            float cosTheta = cos(theta);

            float3 pos = float3(
                radius * sinPhi * cosTheta,
                radius * sinPhi * sinTheta,
                radius * cosPhi
            ) + center;
            float3 normal = normalize(pos - center);

            int outIdx = vertexOffset + vCount;
            vertexPosNormalBuffer[outIdx] = pos;
            vertexPosNormalBuffer[vertexCapacity + outIdx] = normal;
            vertexOutputBuffer_color[vertexOffset + vCount] = color;
            vCount++;
        }
    }

    for (int y = 0; y < sphereSegments; y++)
    {
        for (int x = 0; x < sphereSegments; x++)
        {
            int v0 = x + y * (sphereSegments + 1);
            int v1 = v0 + 1;
            int v2 = v0 + (sphereSegments + 1);
            int v3 = v2 + 1;
            
            indexOutputBuffer[indexOffset + iCount++] = v0 + beginVCount;
            indexOutputBuffer[indexOffset + iCount++] = v2 + beginVCount;
            indexOutputBuffer[indexOffset + iCount++] = v1 + beginVCount;

            indexOutputBuffer[indexOffset + iCount++] = v1 + beginVCount;
            indexOutputBuffer[indexOffset + iCount++] = v2 + beginVCount;
            indexOutputBuffer[indexOffset + iCount++] = v3 + beginVCount;
        }
    }
}

// Emit a cylinder between two atom centers.
void GenerateBondCylinder(float3 start, float3 end, float4 color, int vertexOffset, int indexOffset, inout int vCount, inout int iCount)
{
    float3 dir = normalize(end - start);
    float3 up = abs(dir.y) < 0.9f ? float3(0, 1, 0) : float3(1, 0, 0);
    float3 right = normalize(cross(dir, up));
    up = normalize(cross(right, dir));
    float length = distance(start, end);
    
    int beginVCount = vCount;

    for (int i = 0; i <= cylinderSegments; i++)
    {
        float angle = i * 2 * 3.1415926f / cylinderSegments;
        float x = cos(angle);
        float z = sin(angle);

        float3 offset = right * x * bondRadius + up * z * bondRadius;
        int outIdx0 = vertexOffset + vCount;
        vertexPosNormalBuffer[outIdx0] = start + offset;
        vertexPosNormalBuffer[vertexCapacity + outIdx0] = normalize(offset);
        vertexOutputBuffer_color[vertexOffset + vCount] = color;
        vCount++;

        int outIdx1 = vertexOffset + vCount;
        vertexPosNormalBuffer[outIdx1] = end + offset;
        vertexPosNormalBuffer[vertexCapacity + outIdx1] = normalize(offset);
        vertexOutputBuffer_color[vertexOffset + vCount] = color;
        vCount++;
    }

    for (int i = 0; i < cylinderSegments; i++)
    {
        int v0 = i * 2;
        int v1 = v0 + 1;
        int v2 = (i + 1) * 2;
        int v3 = v2 + 1;

        indexOutputBuffer[indexOffset + iCount++] = v0 + beginVCount;
        indexOutputBuffer[indexOffset + iCount++] = v1 + beginVCount;
        indexOutputBuffer[indexOffset + iCount++] = v2 + beginVCount;

        indexOutputBuffer[indexOffset + iCount++] = v1 + beginVCount;
        indexOutputBuffer[indexOffset + iCount++] = v3 + beginVCount;
        indexOutputBuffer[indexOffset + iCount++] = v2 + beginVCount;
    }
}

[numthreads(32, 1, 1)]
void CSGenerateBallStickMesh(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int meshIdx = dispatchThreadID.x;
    if (meshIdx >= selectedCount)
        return;

    int atomStart = meshAtomStartBuffer[meshIdx];
    int atomCount = meshAtomCountInputBuffer[meshIdx];
    int bondStart = meshBondStartBuffer[meshIdx];
    int bondCount = meshBondCountInputBuffer[meshIdx];
    if (atomCount <= 1)
    {
        meshAtomCountInputBuffer[meshIdx] = 0;
        meshBondCountInputBuffer[meshIdx] = 0;
        return;
    }

    int verticesPerAtom = (sphereSegments + 1) * (sphereSegments + 1);
    int verticesPerBond = 2 * (cylinderSegments + 1);
    int indicesPerAtom = sphereSegments * sphereSegments * 6;
    int indicesPerBond = cylinderSegments * 6;

    int totalVertices = MAX_ATOM_COUNT * verticesPerAtom + maxBondCount * verticesPerBond;
    int totalIndices = MAX_ATOM_COUNT * indicesPerAtom + maxBondCount * indicesPerBond;
    int vertexOffset = meshIdx * totalVertices;
    int indexOffset = meshIdx * totalIndices;

    int vCount = 0;
    int iCount = 0;
    int emittedBondCount = 0;

    for (int a = 0; a < atomCount; a++)
    {
        int atomIndex = atomStart + a;
        GenerateAtomSphere(atomPositionInputBuffer[atomIndex], atomTypeInputBuffer[atomIndex], vertexOffset, indexOffset, vCount, iCount);
    }

    for (int bondIdx = 0; bondIdx < bondCount; bondIdx++)
    {
        int2 bond = bondInputBuffer[bondStart + bondIdx];
        if (bond.x < 0 || bond.y < 0 || bond.x >= atomCount || bond.y >= atomCount || bond.x == bond.y)
            continue;
        int atomA = atomStart + bond.x;
        int atomB = atomStart + bond.y;
        if (distance(atomPositionInputBuffer[atomA], atomPositionInputBuffer[atomB]) < 1e-4f)
            continue;
        float4 color = (GetAtomColor(atomTypeInputBuffer[atomA]) + GetAtomColor(atomTypeInputBuffer[atomB])) * 0.5f;
        GenerateBondCylinder(atomPositionInputBuffer[atomA], atomPositionInputBuffer[atomB], color, vertexOffset, indexOffset, vCount, iCount);
        emittedBondCount++;
    }

    if (emittedBondCount == 0 && atomCount > 1)
    {
        int fallback = min(atomCount - 1, maxBondCount);
        for (int i = 1; i <= fallback; i++)
        {
            int atomA = atomStart + (i - 1);
            int atomB = atomStart + i;
            if (distance(atomPositionInputBuffer[atomA], atomPositionInputBuffer[atomB]) < 1e-4f)
                continue;
            float4 color = (GetAtomColor(atomTypeInputBuffer[atomA]) + GetAtomColor(atomTypeInputBuffer[atomB])) * 0.5f;
            GenerateBondCylinder(atomPositionInputBuffer[atomA], atomPositionInputBuffer[atomB], color, vertexOffset, indexOffset, vCount, iCount);
            emittedBondCount++;
        }
    }
    meshBondCountInputBuffer[meshIdx] = emittedBondCount;
}
